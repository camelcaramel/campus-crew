# Copy to the repository-root .env once. Local learning values only.
POSTGRES_DB=campus_crew
POSTGRES_USER=campus_crew
POSTGRES_PASSWORD=campus_crew
POSTGRES_PORT=5432

# Used by Prisma CLI and seed in session 16; NestJS API is still in-memory.
# Keep credentials and port in sync with the values above.
DATABASE_URL=postgresql://campus_crew:campus_crew@localhost:5432/campus_crew?schema=public
