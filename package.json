{
  "name": "campus-crew",
  "version": "0.1.0",
  "private": true,
  "description": "Campus Crew 30차시 풀스택 수업 — 4차시 checkpoint",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.17.1",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev:web": "npm run dev --workspace=@campus-crew/web",
    "dev:api": "npm run dev --workspace=@campus-crew/api",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "start:web": "npm run start --workspace=@campus-crew/web",
    "start:api": "npm run start --workspace=@campus-crew/api",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.3.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.18.6",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
